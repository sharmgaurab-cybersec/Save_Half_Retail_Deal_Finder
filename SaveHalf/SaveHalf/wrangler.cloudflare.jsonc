{
  "name": "save-half-retail-deal-finder",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-05-15",
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "savehalf-db",
    "database_id": "eb713092-165c-49b5-bb1b-6285775edf04"
  }],
  "keep_vars": true,
  "observability": { "enabled": true }
}
